<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net10.0;net11.0</TargetFrameworks>
    <!-- C# 15 on every target, so the tests can use union syntax on ByteOrTrigger below net11.0 too. -->
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <NoWarn>TUnit0046;TUnit0018;TUnitAssertions0003;CS8892</NoWarn>
    <EnableMicrosoftTestingPlatform>true</EnableMicrosoftTestingPlatform>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <TreatWarningsAsErrors>True</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <TreatWarningsAsErrors>True</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Raw wire captures replayed by the tests. Embedded so no test ever touches the network. -->
    <EmbeddedResource Include="Fixtures\*.bin" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TelnetNegotiationCore\TelnetNegotiationCore.csproj" />
    <ProjectReference Include="..\TelnetNegotiationCore.Gmcp\TelnetNegotiationCore.Gmcp.csproj" />
  </ItemGroup>

  <!--
    The .NET 11 packages have no net8.0 build; net8.0 keeps the .NET 10 line (see TelnetNegotiationCore.csproj).
    TUnit dropped net8.0 in 1.83; 1.81.16 is its last release that targets it.
  -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="TUnit" Version="1.81.16" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' != 'net8.0'">
    <PackageReference Include="TUnit" Version="1.*" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="11.0.0" />
  </ItemGroup>

</Project>
